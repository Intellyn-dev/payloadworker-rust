  "query": "\n        UPDATE jobs SET status = 'processing', updated_at = NOW()\n        WHERE id = (\n            SELECT id FROM jobs WHERE status = 'pending'\n            ORDER BY created_at ASC\n            LIMIT 1\n            FOR UPDATE SKIP LOCKED\n        )\n        RETURNING id, payload, status, attempts, created_at, updated_at\n        ",
